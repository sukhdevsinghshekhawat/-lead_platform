# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database URL (PostgreSQL)
# For local development, Rails will use config/database.yml
# For production, provide a full PostgreSQL connection string:
# DATABASE_URL=postgres://user:password@host:5432/database_name

# JWT Secret Key
# Used to sign and verify JSON Web Tokens
# Leave blank to use Rails secret_key_base (default)
JWT_SECRET=

# Rails Environment
# Options: development, test, production
RAILS_ENV=development

# Port for the Rails server
PORT=3000

